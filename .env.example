# =============================================================================
# SERVICENOW - OBLIGATORIO
# =============================================================================
SERVICENOW_INSTANCE=https://tu-instancia.service-now.com
SERVICENOW_USERNAME=usuario
SERVICENOW_PASSWORD=contraseña

# Déjala comentada para utilizar la ruta My To-Do original del proyecto.
# SERVICENOW_TODO_URL=https://tu-instancia.service-now.com/now/cwf/agent/simplelist/task/params/...

SERVICENOW_TABLE=task
SERVICENOW_QUERY_MARKER=assigned_to
SERVICENOW_PIPELINE_ID=sn_record_list_composite_broker

# =============================================================================
# DISCORD
# =============================================================================
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx
DISCORD_USERNAME=ServiceNow Monitor
DISCORD_MAX_ATTEMPTS=4
DISCORD_MAX_BACKOFF_SECONDS=60

# =============================================================================
# EJECUCIÓN Y RECUPERACIÓN
# =============================================================================
TZ=America/Mexico_City
HEADLESS=true
IGNORE_HTTPS_ERRORS=false
REFRESH_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
CAPTURE_TIMEOUT_SECONDS=90
SERVICENOW_REQUEST_ATTEMPTS=3

# 2 fallos: recaptura; 4: reinicia Chromium; 6: Docker reinicia el proceso.
RECAPTURE_AFTER_FAILURES=2
RESTART_BROWSER_AFTER_FAILURES=4
EXIT_AFTER_FAILURES=6
MAX_BACKOFF_SECONDS=60

# Argumentos opcionales separados por coma.
# CHROMIUM_ARGS=--proxy-server=http://proxy:8080

# =============================================================================
# LOGS Y DEBUG EFÍMEROS DENTRO DEL CONTENEDOR
# =============================================================================
# No hay STATE_FILE ni volumen data. Los tickets conocidos solo viven en memoria.
LOG_DIR=/var/log/sn-monitor
DIAGNOSTIC_DIR=/var/log/sn-monitor/diagnostics
HEALTH_FILE=/run/sn-monitor/health.json
HEALTH_MAX_AGE_SECONDS=300

LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
DIAGNOSTIC_MAX_FILES=40
DIAGNOSTIC_MAX_TOTAL_BYTES=100663296

SAVE_RESPONSE_BODY_ON_ERROR=true
SAVE_SCREENSHOT_ON_ERROR=true
SAVE_PAGE_HTML_ON_ERROR=false
MAX_DIAGNOSTIC_TEXT_CHARS=1000000
